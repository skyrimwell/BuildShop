### Unreal Engine Git Attributes / LFS List ###

# Define
[attr]lfs filter=lfs diff=lfs merge=lfs -text

* text=auto

# Unreal Engine general
*.uasset lfs
*.umap lfs

*.bin lfs
*.pak lfs

# Unreal Engine localization
*.locres lfs
*.locmeta lfs
*.archive lfs
*.manifest lfs
*.po text eol=lf

# Unreal Engine code
*.cpp text diff=cpp eol=lf charset=utf-8
*.h text diff=cpp eol=lf charset=utf-8
*.hpp text diff=cpp eol=lf charset=utf-8
*.cs text diff=csharp eol=lf charset=utf-8

*.Build.cs text diff=csharp eol=lf charset=utf-8
*.Target.cs text diff=csharp eol=lf charset=utf-8
*.Editor.Target.cs text diff=csharp eol=lf charset=utf-8

# Other files
# *.sln text eol=crlf
# *.vcxproj text eol=crlf
# *.vcxproj.filters text eol=crlf
# *.vssettings text eol=crlf

# .vscode/*.json text eol=lf

*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Media
*.png lfs
*.jpg lfs
*.jpeg lfs
*.tga lfs
*.bmp lfs
*.psd lfs
*.dds lfs
*.exr lfs
*.hdr lfs

*.wav lfs
*.mp3 lfs
*.ogg lfs
*.flac lfs

*.mp4 lfs
*.avi lfs
*.mov lfs
*.wmv lfs

# End
